#!/usr/bin/env python3
"""Record evidence that distinguishes local, DNS, and upstream outages."""

from __future__ import annotations

import argparse
from ipaddress import ip_address
import json
import logging
import logging.handlers
import os
from pathlib import Path
import plistlib
import re
import signal
import socket
import ssl
import subprocess
import sys
import time
from collections import Counter, deque
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from typing import Any, Deque, Dict, List, Mapping, Optional, Sequence, TextIO, Tuple, Union, cast
from urllib.parse import urlsplit
from uuid import uuid4


ROOT = Path.home() / "Library" / "LaunchAgents"
DEFAULT_LOG_DIR = (
    Path.home()
    / "Google Drive"
    / "My Drive"
    / "Codex"
    / "runtime"
    / "network-monitor"
)
LABEL = "local.codex.network-monitor"
DEFAULT_HOSTS = ("github.com", "api.github.com", "chatgpt.com")
CODEX_HOST = "chatgpt.com"
CODEX_TRANSPORT_PATH = "/backend-api/codex/responses"
CODEX_TRANSPORT_URL = "https://" + CODEX_HOST + CODEX_TRANSPORT_PATH
CODEX_TRANSPORT_TIMEOUT_MARGIN = 5.0
PROXY_ENVIRONMENT_NAMES = (
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
    "no_proxy",
)
MAX_LOG_BYTES = 4 * 1024 * 1024
LOG_BACKUPS = 4


def configured_hosts(directory: Path = DEFAULT_LOG_DIR) -> Tuple[str, ...]:
    """Load private provider hosts without embedding them in source code."""
    path = directory / "config.json"
    if not path.exists():
        return DEFAULT_HOSTS
    if path.is_symlink() or not path.is_file():
        raise ValueError("network host configuration must be a regular file")
    with path.open("r", encoding="utf-8") as handle:
        decoded: object = json.load(handle)
    if not isinstance(decoded, dict):
        raise ValueError("network host configuration must be an object")
    configuration = cast(Dict[str, object], decoded)
    raw_hosts = configuration.get("hosts")
    if not isinstance(raw_hosts, list) or not raw_hosts:
        raise ValueError("network host configuration requires a nonempty host list")
    hosts: List[str] = []
    for host in cast(List[object], raw_hosts):
        if not isinstance(host, str) or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]*", host) is None:
            raise ValueError("network host configuration contains an invalid hostname")
        hosts.append(host)
    return tuple(hosts)


DNS_HELPER = (
    "import json,socket,sys; "
    "items=socket.getaddrinfo(sys.argv[1],443,type=socket.SOCK_STREAM); "
    "print(json.dumps([{'family':int(item[0]),'address':item[4]} for item in items]))"
)
CODEX_TRANSPORT_HELPER = """\
import json
import socket
import ssl
import sys
import urllib.error
import urllib.request
from urllib.parse import urlsplit

url = sys.argv[1]
host = urlsplit(url).hostname
proxies = urllib.request.getproxies()
via_proxy = bool(proxies.get(urlsplit(url).scheme))
if host is not None and urllib.request.proxy_bypass(host):
    via_proxy = False
request = urllib.request.Request(
    url,
    headers={"User-Agent": "codex-network-monitor/1"},
    method="HEAD",
)
try:
    with urllib.request.urlopen(request, timeout=float(sys.argv[2])) as response:
        result = {"phase": "ok", "http_status": response.status}
except urllib.error.HTTPError as error:
    result = {"phase": "ok", "http_status": error.code}
    error.close()
except urllib.error.URLError as error:
    reason = error.reason
    if isinstance(reason, socket.gaierror):
        phase = "dns"
    elif isinstance(reason, ssl.SSLError):
        phase = "tls"
    elif isinstance(reason, (TimeoutError, ConnectionError, socket.timeout)):
        phase = "tcp"
    else:
        phase = "http"
    result = {"phase": phase, "error": type(reason).__name__}
except (OSError, ValueError) as error:
    result = {"phase": "tcp", "error": type(error).__name__}
result["via_proxy"] = via_proxy
print(json.dumps(result, sort_keys=True, separators=(",", ":")))
"""


@dataclass(frozen=True)
class Probe:
    host: str
    phase: str
    elapsed_ms: int
    address: Optional[str] = None
    http_status: Optional[int] = None
    redirect_host: Optional[str] = None
    error: Optional[str] = None
    path: str = "/"
    via_proxy: Optional[bool] = None


@dataclass(frozen=True)
class Route:
    gateway: Optional[str]
    interface: Optional[str]
    interface_status: Optional[str]
    gateway_reachable: Optional[bool]


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def command(args: Sequence[str], timeout: float) -> Tuple[int, str]:
    try:
        result = subprocess.run(
            list(args),
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return -1, "timeout"
    except OSError as error:
        return -1, type(error).__name__
    return result.returncode, result.stdout


SocketAddress = Union[Tuple[str, int], Tuple[str, int, int, int]]


def resolve(
    host: str, timeout: float
) -> Tuple[Optional[Tuple[int, SocketAddress]], Optional[str]]:
    code, output = command(("/usr/bin/python3", "-c", DNS_HELPER, host), timeout)
    if code != 0:
        return None, "resolver_timeout" if output == "timeout" else "resolver_failed"
    try:
        decoded: object = json.loads(output)
        if not isinstance(decoded, list) or not decoded:
            return None, "empty_dns_response"
        candidates = cast(List[object], decoded)
        raw_candidate = candidates[0]
        if not isinstance(raw_candidate, dict):
            return None, "invalid_dns_response"
        candidate = cast(Dict[str, object], raw_candidate)
        family = candidate.get("family")
        raw_address = candidate.get("address")
        if not isinstance(family, int) or not isinstance(raw_address, list):
            return None, "invalid_dns_response"
        parts = cast(List[object], raw_address)
        if (
            family == socket.AF_INET
            and len(parts) == 2
            and isinstance(parts[0], str)
            and isinstance(parts[1], int)
        ):
            address: SocketAddress = (parts[0], parts[1])
        elif (
            family == socket.AF_INET6
            and len(parts) == 4
            and isinstance(parts[0], str)
            and isinstance(parts[1], int)
            and isinstance(parts[2], int)
            and isinstance(parts[3], int)
        ):
            address = (parts[0], parts[1], parts[2], parts[3])
        else:
            return None, "invalid_dns_response"
        return (family, address), None
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        return None, "invalid_dns_response"


def probe(
    host: str,
    timeout: float,
    path: str = "/",
) -> Probe:
    started = time.monotonic()

    def elapsed() -> int:
        return round((time.monotonic() - started) * 1000)

    resolved, dns_error = resolve(host, timeout)
    if resolved is None:
        return Probe(
            host=host,
            phase="dns",
            elapsed_ms=elapsed(),
            error=dns_error,
            path=path,
        )

    family, address = resolved
    ip_address = str(address[0])
    try:
        connection = socket.socket(family, socket.SOCK_STREAM)
        connection.settimeout(timeout)
        connection.connect(address)
    except (OSError, ValueError) as error:
        return Probe(
            host=host,
            phase="tcp",
            elapsed_ms=elapsed(),
            address=ip_address,
            error=type(error).__name__,
            path=path,
        )

    with connection:
        try:
            context = ssl.create_default_context()
            secured = context.wrap_socket(connection, server_hostname=host)
        except (OSError, ssl.SSLError, ValueError) as error:
            return Probe(
                host=host,
                phase="tls",
                elapsed_ms=elapsed(),
                address=ip_address,
                error=type(error).__name__,
                path=path,
            )

        with secured:
            try:
                secured.settimeout(timeout)
                request = (
                    "HEAD " + path + " HTTP/1.1\r\n"
                    "Host: " + host + "\r\n"
                    "User-Agent: codex-network-monitor/1\r\n"
                    "Connection: close\r\n\r\n"
                )
                secured.sendall(request.encode("ascii"))
                response = secured.recv(4096)
                first_line = response.split(b"\r\n", 1)[0]
                match = re.match(rb"HTTP/\d(?:\.\d)?\s+(\d{3})", first_line)
                if match is None:
                    return Probe(
                        host=host,
                        phase="http",
                        elapsed_ms=elapsed(),
                        address=ip_address,
                        error="invalid_http_response",
                        path=path,
                    )
                status = int(match.group(1))
                redirect_host = None
                if 300 <= status < 400:
                    location = re.search(rb"(?im)^location:\s*([^\r\n]+)", response)
                    if location is not None:
                        redirect_host = urlsplit(
                            location.group(1).decode("ascii", errors="replace")
                        ).hostname
                return Probe(
                    host=host,
                    phase="ok",
                    elapsed_ms=elapsed(),
                    address=ip_address,
                    http_status=status,
                    redirect_host=redirect_host,
                    path=path,
                )
            except (OSError, ValueError) as error:
                return Probe(
                    host=host,
                    phase="http",
                    elapsed_ms=elapsed(),
                    address=ip_address,
                    error=type(error).__name__,
                    path=path,
                )


def probe_codex_transport(timeout: float) -> Probe:
    started = time.monotonic()
    transport_timeout = timeout + CODEX_TRANSPORT_TIMEOUT_MARGIN
    code, output = command(
        (
            "/usr/bin/python3",
            "-c",
            CODEX_TRANSPORT_HELPER,
            CODEX_TRANSPORT_URL,
            str(transport_timeout),
        ),
        transport_timeout,
    )
    elapsed_ms = round((time.monotonic() - started) * 1000)
    if code != 0:
        return Probe(
            host=CODEX_HOST,
            phase="tcp",
            elapsed_ms=elapsed_ms,
            error="transport_timeout" if output == "timeout" else "transport_failed",
            path=CODEX_TRANSPORT_PATH,
        )
    try:
        decoded: object = json.loads(output)
        if not isinstance(decoded, dict):
            raise ValueError("transport result is not an object")
        result = cast(Dict[str, object], decoded)
        phase = result.get("phase")
        status = result.get("http_status")
        error = result.get("error")
        via_proxy = result.get("via_proxy")
        if phase not in ("ok", "dns", "tcp", "tls", "http"):
            raise ValueError("unknown transport phase")
        if status is not None and not isinstance(status, int):
            raise ValueError("invalid transport HTTP status")
        if error is not None and not isinstance(error, str):
            raise ValueError("invalid transport error")
        if not isinstance(via_proxy, bool):
            raise ValueError("invalid transport proxy state")
        return Probe(
            host=CODEX_HOST,
            phase=phase,
            elapsed_ms=elapsed_ms,
            http_status=status,
            error=error,
            path=CODEX_TRANSPORT_PATH,
            via_proxy=via_proxy,
        )
    except (TypeError, ValueError, json.JSONDecodeError):
        return Probe(
            host=CODEX_HOST,
            phase="http",
            elapsed_ms=elapsed_ms,
            error="invalid_transport_response",
            path=CODEX_TRANSPORT_PATH,
        )


def route_snapshot(timeout: float, ping_gateway: bool) -> Route:
    code, output = command(("/sbin/route", "-n", "get", "default"), timeout)
    if code != 0:
        return Route(None, None, None, None)
    gateway_match = re.search(r"^\s*gateway:\s+(\S+)", output, re.MULTILINE)
    interface_match = re.search(r"^\s*interface:\s+(\S+)", output, re.MULTILINE)
    gateway = gateway_match.group(1) if gateway_match else None
    interface = interface_match.group(1) if interface_match else None
    interface_status = None
    if interface:
        interface_code, interface_output = command(("/sbin/ifconfig", interface), timeout)
        if interface_code == 0:
            status_match = re.search(
                r"^\s*status:\s+(\S+)", interface_output, re.MULTILINE
            )
            interface_status = status_match.group(1) if status_match else "present"
    gateway_reachable = None
    if ping_gateway and gateway:
        ping_code, _ = command(("/sbin/ping", "-n", "-c", "1", "-W", "1000", gateway), timeout + 1)
        gateway_reachable = ping_code == 0
    return Route(gateway, interface, interface_status, gateway_reachable)


def resolver_snapshot(timeout: float) -> Dict[str, Any]:
    code, output = command(("/usr/sbin/scutil", "--dns"), timeout)
    if code != 0:
        return {"available": False}
    addresses = re.findall(r"^\s*nameserver\[\d+\]\s*:\s*(\S+)", output, re.MULTILINE)
    return {"available": True, "nameservers": list(dict.fromkeys(addresses))[:8]}


def classify(probes: Sequence[Probe], route: Route) -> str:
    failures = [item for item in probes if item.phase != "ok"]
    if not failures:
        if any(
            item.host == CODEX_HOST
            and item.path == CODEX_TRANSPORT_PATH
            and item.http_status is not None
            and item.http_status >= 500
            for item in probes
        ):
            return "codex_transport_http_error"
        suspicious_redirects = [
            item.redirect_host
            for item in probes
            if item.redirect_host
            and item.redirect_host != item.host
            and not item.redirect_host.endswith("." + item.host)
        ]
        if any(count >= 2 for count in Counter(suspicious_redirects).values()):
            return "possible_captive_portal"
        return "healthy"
    if len(failures) < len(probes):
        if all(item.phase == "dns" for item in failures):
            return "partial_dns_failure"
        if len(failures) == 1:
            if (
                failures[0].host == CODEX_HOST
                and failures[0].path == CODEX_TRANSPORT_PATH
            ):
                return "codex_transport_failure"
            return "provider_specific_failure"
        return "partial_connectivity_failure"
    if not route.gateway or route.interface_status == "inactive":
        return "local_route_or_interface"
    if (
        route.gateway_reachable is False
        and route.interface is not None
        and not route.interface.startswith(("utun", "ppp", "ipsec"))
    ):
        return "local_gateway_unreachable"
    if len(failures) == len(probes):
        phases = {item.phase for item in failures}
        if phases == {"dns"}:
            return "dns_resolver_failure"
        if phases == {"tls"}:
            return "tls_or_proxy_failure"
        return "upstream_or_internet_outage"
    return "upstream_or_internet_outage"


class BoundedRotatingFileHandler(logging.handlers.RotatingFileHandler):
    """Keep network diagnostics bounded and accessible only to their owner."""

    def _open(self) -> TextIO:
        stream = super()._open()
        os.chmod(self.baseFilename, 0o600)
        return stream

    def emit(self, record: logging.LogRecord) -> None:
        formatted = self.format(record)
        original_bytes = len(formatted.encode("utf-8")) + 1
        if self.maxBytes > 0 and original_bytes > self.maxBytes:
            try:
                decoded: object = json.loads(formatted)
            except (TypeError, ValueError):
                decoded = {}
            event = cast(Dict[str, object], decoded) if isinstance(decoded, dict) else {}
            bounded: Dict[str, object] = {
                key: event[key]
                for key in (
                    "at",
                    "event",
                    "classification",
                    "previous_classification",
                    "outage_id",
                )
                if key in event
            }
            bounded["truncated"] = True
            bounded["original_bytes"] = original_bytes
            replacement = json.dumps(bounded, sort_keys=True, separators=(",", ":"))
            if len(replacement.encode("utf-8")) + 1 > self.maxBytes:
                replacement = json.dumps(
                    {"event": "oversized_record", "truncated": True},
                    sort_keys=True,
                    separators=(",", ":"),
                )
            if len(replacement.encode("utf-8")) + 1 > self.maxBytes:
                return
            bounded_record = logging.makeLogRecord(dict(record.__dict__))
            bounded_record.msg = replacement
            bounded_record.args = ()
            record = bounded_record
        super().emit(record)


def logger_for(directory: Path) -> logging.Logger:
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    logger = logging.getLogger("codex.network")
    logger.setLevel(logging.INFO)
    logger.propagate = False
    for existing in list(logger.handlers):
        logger.removeHandler(existing)
        existing.close()
    handler = BoundedRotatingFileHandler(
        str(directory / "events.jsonl"),
        maxBytes=MAX_LOG_BYTES,
        backupCount=LOG_BACKUPS,
        encoding="utf-8",
    )
    handler.setFormatter(logging.Formatter("%(message)s"))
    logger.addHandler(handler)
    return logger


def write_status(path: Path, value: Dict[str, Any]) -> None:
    temporary = path.with_suffix(".tmp")
    descriptor = os.open(
        str(temporary), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600
    )
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        os.chmod(str(temporary), 0o600)
        json.dump(value, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")
    os.replace(str(temporary), str(path))


def build_observation(hosts: Sequence[str], timeout: float) -> Dict[str, Any]:
    codex_transport = probe_codex_transport(timeout) if CODEX_HOST in hosts else None
    probes = [probe(host, timeout) for host in hosts]
    if codex_transport is not None:
        probes.append(codex_transport)
    failed = any(item.phase != "ok" for item in probes)
    route = route_snapshot(timeout, ping_gateway=failed)
    observation: Dict[str, Any] = {
        "at": utc_now(),
        "monotonic": round(time.monotonic(), 3),
        "classification": classify(probes, route),
        "route": asdict(route),
        "probes": [asdict(item) for item in probes],
    }
    if failed:
        observation["resolvers"] = resolver_snapshot(timeout)
    return observation


class NetworkMonitor:
    def __init__(
        self,
        hosts: Sequence[str],
        interval: float,
        timeout: float,
        log_directory: Path,
    ) -> None:
        self.hosts = tuple(hosts)
        self.interval = interval
        self.timeout = timeout
        self.log_directory = log_directory
        self.logger = logger_for(log_directory)
        self.context: Deque[Dict[str, Any]] = deque(maxlen=8)
        self.previous_classification: Optional[str] = None
        self.previous_route: Optional[Dict[str, Any]] = None
        self.outage_id: Optional[str] = None
        self.last_logged_at = 0.0
        self.running = True

    def record(self, observation: Dict[str, Any]) -> None:
        classification = str(observation["classification"])
        monotonic = float(observation["monotonic"])
        route = observation["route"]
        changed = classification != self.previous_classification
        route_changed = route != self.previous_route
        if changed and classification != "healthy":
            self.outage_id = str(uuid4())
        kind = "transition" if changed else "route_change" if route_changed else "heartbeat"
        should_log = changed or route_changed or monotonic - self.last_logged_at >= 300
        if should_log:
            event = dict(observation)
            event["event"] = kind
            event["previous_classification"] = self.previous_classification
            event["outage_id"] = self.outage_id
            if changed:
                event["preceding_samples"] = list(self.context)
            self.logger.info(json.dumps(event, sort_keys=True, separators=(",", ":")))
            self.last_logged_at = monotonic
        write_status(self.log_directory / "status.json", observation)
        self.context.append(observation)
        self.previous_classification = classification
        self.previous_route = route
        if changed and classification == "healthy":
            self.outage_id = None

    def stop(self, _signal: int, _frame: Any) -> None:
        self.running = False

    def run(self) -> None:
        signal.signal(signal.SIGTERM, self.stop)
        signal.signal(signal.SIGINT, self.stop)
        while self.running:
            started = time.monotonic()
            try:
                self.record(build_observation(self.hosts, self.timeout))
            except Exception as error:
                event = {
                    "at": utc_now(),
                    "event": "monitor_error",
                    "error_type": type(error).__name__,
                }
                self.logger.error(json.dumps(event, sort_keys=True, separators=(",", ":")))
            remaining = self.interval - (time.monotonic() - started)
            if remaining > 0 and self.running:
                time.sleep(remaining)


def ensure_launch_template() -> Path:
    template = ROOT / (LABEL + ".plist")
    if template.exists():
        return template

    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    configuration: Dict[str, Any] = {
        "Label": LABEL,
        "ProgramArguments": [
            "/usr/bin/python3",
            str(Path(__file__).resolve()),
            "monitor",
        ],
        "WorkingDirectory": str(Path.home()),
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 15,
        "ProcessType": "Background",
        "StandardOutPath": "/dev/null",
        "StandardErrorPath": "/dev/null",
    }
    temporary = template.with_suffix(".tmp")
    descriptor = os.open(
        str(temporary), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600
    )
    with os.fdopen(descriptor, "wb") as handle:
        plistlib.dump(configuration, handle, sort_keys=True)
    os.chmod(str(temporary), 0o600)
    os.replace(str(temporary), str(template))
    return template


def configured_launch_plist(
    environment: Mapping[str, str], directory: Path = DEFAULT_LOG_DIR
) -> Path:
    template = ensure_launch_template()
    proxy_environment: Dict[str, str] = {}
    for name in PROXY_ENVIRONMENT_NAMES:
        if name not in environment or name.lower() == "no_proxy":
            continue
        value = environment[name]
        try:
            parsed = urlsplit(value)
            hostname = parsed.hostname
            if hostname is None or parsed.username is not None or parsed.password is not None:
                continue
            if hostname != "localhost" and not ip_address(hostname).is_loopback:
                continue
        except ValueError:
            continue
        proxy_environment[name] = value
    if not proxy_environment:
        return template
    for name in ("NO_PROXY", "no_proxy"):
        if name in environment:
            proxy_environment[name] = environment[name]
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    with template.open("rb") as source:
        decoded: object = plistlib.load(source)
    if not isinstance(decoded, dict):
        raise ValueError("LaunchAgent template is not a dictionary")
    configuration = cast(Dict[str, Any], decoded)
    configuration["EnvironmentVariables"] = proxy_environment
    destination = (
        ROOT / (LABEL + ".plist")
        if directory == DEFAULT_LOG_DIR
        else directory / (LABEL + ".plist")
    )
    temporary = destination.with_suffix(".tmp")
    descriptor = os.open(
        str(temporary), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600
    )
    with os.fdopen(descriptor, "wb") as handle:
        plistlib.dump(configuration, handle, sort_keys=True)
    os.chmod(str(temporary), 0o600)
    os.replace(str(temporary), str(destination))
    return destination


def install() -> int:
    service = "gui/" + str(os.getuid())
    plist = configured_launch_plist(os.environ)
    validation = subprocess.run(("/usr/bin/plutil", "-lint", str(plist)), check=False)
    if validation.returncode != 0:
        return validation.returncode
    inspected = subprocess.run(
        ("/bin/launchctl", "print", service + "/" + LABEL),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if inspected.returncode == 0:
        if plist == ROOT / (LABEL + ".plist"):
            restarted = subprocess.run(
                ("/bin/launchctl", "kickstart", "-k", service + "/" + LABEL),
                check=False,
            )
            return restarted.returncode
        stopped = subprocess.run(
            ("/bin/launchctl", "bootout", service + "/" + LABEL), check=False
        )
        if stopped.returncode != 0:
            return stopped.returncode
    result = subprocess.run(
        ("/bin/launchctl", "bootstrap", service, str(plist)), check=False
    )
    if result.returncode != 0 and plist != ROOT / (LABEL + ".plist"):
        subprocess.run(
            ("/bin/launchctl", "bootstrap", service, str(ROOT / (LABEL + ".plist"))),
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    return result.returncode


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command")
    monitor_parser = commands.add_parser("monitor", help="run the persistent network monitor")
    monitor_parser.add_argument("--interval", type=float, default=15.0)
    monitor_parser.add_argument("--timeout", type=float, default=2.0)
    monitor_parser.add_argument("--log-dir", type=Path, default=DEFAULT_LOG_DIR)
    monitor_parser.add_argument("--host", action="append", dest="hosts")
    diagnose_parser = commands.add_parser("diagnose", help="print one complete network observation")
    diagnose_parser.add_argument("--timeout", type=float, default=2.0)
    diagnose_parser.add_argument("--host", action="append", dest="hosts")
    status_parser = commands.add_parser("status", help="print the last recorded observation")
    status_parser.add_argument("--log-dir", type=Path, default=DEFAULT_LOG_DIR)
    commands.add_parser("install", help="install and start the macOS LaunchAgent")
    args = parser.parse_args(argv)
    if args.command == "install":
        return install()
    if args.command == "diagnose":
        print(json.dumps(build_observation(args.hosts or configured_hosts(), args.timeout), indent=2))
        return 0
    if args.command == "status":
        path = args.log_dir / "status.json"
        if not path.exists():
            print("No network observations have been recorded.", file=sys.stderr)
            return 1
        print(path.read_text(encoding="utf-8"), end="")
        return 0
    if args.command == "monitor":
        if args.interval <= 0 or args.timeout <= 0:
            parser.error("interval and timeout must be positive")
        NetworkMonitor(
            args.hosts or configured_hosts(args.log_dir),
            args.interval,
            args.timeout,
            args.log_dir,
        ).run()
        return 0
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
