#!/usr/bin/env python3
"""Safely classify a misplaced Git checkout without walking unrelated repositories."""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import stat
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import BinaryIO, Iterator


@dataclass(frozen=True)
class IndexEntry:
    path: bytes
    object_id: bytes
    mode: bytes


@dataclass
class Result:
    candidates: list[str] = field(default_factory=list)
    matched: int = 0
    modified: list[str] = field(default_factory=list)
    untracked: list[str] = field(default_factory=list)
    protected: list[str] = field(default_factory=list)
    special: list[str] = field(default_factory=list)
    scanned_files: int = 0
    hashed_bytes: int = 0
    complete: bool = True


def records(stream: BinaryIO) -> Iterator[bytes]:
    remaining = b""
    while True:
        chunk = stream.read(65536)
        if not chunk:
            if remaining:
                raise ValueError("Git returned an unterminated index record")
            return
        parts = (remaining + chunk).split(b"\0")
        remaining = parts.pop()
        yield from parts


def tracked_roots(repository: Path) -> set[bytes]:
    output = subprocess.run(
        ["git", "-C", str(repository), "ls-tree", "--name-only", "-z", "HEAD"],
        check=True,
        stdout=subprocess.PIPE,
    ).stdout
    return set(filter(None, output.split(b"\0")))


def snapshot_roots(root: Path, repository: Path) -> list[Path]:
    if root.resolve() == repository.resolve():
        raise ValueError("The orphan root must not be the canonical repository")
    if (root / ".git").exists() or (root / ".git").is_symlink():
        raise ValueError("Refusing to modify a genuine Git checkout")
    expected = tracked_roots(repository)
    with os.scandir(root) as entries:
        candidates = sorted(
            (root / entry.name for entry in entries if os.fsencode(entry.name) in expected),
            key=lambda path: os.fsencode(path.name),
        )
    for path in candidates:
        if path.is_symlink():
            raise ValueError(f"Refusing to modify symlink {path}")
        if path.is_dir():
            if (path / ".git").exists() or (path / ".git").is_symlink():
                raise ValueError(f"Refusing to modify Git checkout {path}")
            with os.scandir(path) as children:
                for child in children:
                    if not child.is_dir(follow_symlinks=False):
                        continue
                    child_path = Path(child.path)
                    if (child_path / ".git").exists() or (child_path / ".git").is_symlink():
                        raise ValueError(f"Refusing to modify nested Git checkout {child_path}")
        elif not path.is_file():
            raise ValueError(f"Refusing to modify special file {path}")
    return candidates


def index_entries(repository: Path, roots: list[bytes]) -> Iterator[IndexEntry]:
    command: list[str | bytes] = [
        "git",
        "-C",
        str(repository),
        "ls-files",
        "--stage",
        "-z",
        "--",
        *roots,
    ]
    process = subprocess.Popen(command, stdout=subprocess.PIPE)
    if process.stdout is None:
        raise RuntimeError("Could not read the canonical Git index")
    try:
        for record in records(process.stdout):
            header, separator, path = record.partition(b"\t")
            if not separator:
                raise ValueError("Invalid canonical Git index record")
            mode, object_id, stage = header.split(b" ")
            if stage != b"0":
                raise ValueError("Canonical Git index contains unresolved conflicts")
            yield IndexEntry(path, object_id, mode)
    finally:
        process.stdout.close()
        return_code = process.wait()
        if return_code:
            raise subprocess.CalledProcessError(return_code, command)


def walk(root: Path, candidates: list[bytes], result: Result) -> Iterator[Path]:
    stack = [root / os.fsdecode(name) for name in reversed(candidates)]
    while stack:
        path = stack.pop()
        relative = path.relative_to(root)
        try:
            info = path.lstat()
        except OSError as error:
            raise RuntimeError(f"Cannot inspect {relative}: {error}") from error
        if stat.S_ISLNK(info.st_mode):
            result.special.append(str(relative))
        elif stat.S_ISREG(info.st_mode):
            yield path
        elif stat.S_ISDIR(info.st_mode):
            if (path / ".git").exists() or (path / ".git").is_symlink():
                result.protected.append(str(relative))
                continue
            try:
                with os.scandir(path) as directory:
                    children = list(directory)
            except OSError as error:
                raise RuntimeError(f"Cannot inspect {relative}: {error}") from error

            def sort_key(entry: os.DirEntry[str]) -> bytes:
                name = os.fsencode(entry.name)
                if entry.is_dir(follow_symlinks=False):
                    return name + b"/"
                return name

            children.sort(key=sort_key, reverse=True)
            stack.extend(Path(entry.path) for entry in children)
        else:
            result.special.append(str(relative))


def blob_id(path: Path, size: int) -> bytes:
    digest = hashlib.sha1()
    digest.update(f"blob {size}\0".encode("ascii"))
    with path.open("rb") as content:
        while chunk := content.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest().encode("ascii")


def audit(
    root: Path,
    repository: Path,
    *,
    max_files: int,
    max_hash_bytes: int,
) -> Result:
    if root.resolve() == repository.resolve():
        raise ValueError("The orphan root must not be the canonical repository")
    if (root / ".git").exists() or (root / ".git").is_symlink():
        raise ValueError("Refusing to audit a genuine Git checkout as an orphan")
    expected_roots = tracked_roots(repository)
    with os.scandir(root) as entries:
        candidates = sorted(
            os.fsencode(entry.name)
            for entry in entries
            if os.fsencode(entry.name) in expected_roots
        )
    result = Result(candidates=[os.fsdecode(name) for name in candidates])
    if not candidates:
        return result
    index = index_entries(repository, candidates)
    current = next(index, None)
    try:
        for path in walk(root, candidates, result):
            if result.scanned_files >= max_files:
                result.complete = False
                break
            size = path.lstat().st_size
            if result.hashed_bytes + size > max_hash_bytes:
                result.complete = False
                break
            relative = os.fsencode(str(path.relative_to(root)))
            result.scanned_files += 1
            while current is not None and current.path < relative:
                current = next(index, None)
            if current is None or current.path != relative:
                result.untracked.append(os.fsdecode(relative))
                continue
            if current.mode not in (b"100644", b"100755"):
                result.special.append(os.fsdecode(relative))
                current = next(index, None)
                continue
            result.hashed_bytes += size
            if blob_id(path, size) == current.object_id:
                result.matched += 1
            else:
                result.modified.append(os.fsdecode(relative))
            current = next(index, None)
    finally:
        index.close()
    return result


def archive(result: Result, root: Path, home: Path) -> int:
    if not result.complete:
        raise ValueError("Refusing to archive or remove an incompletely audited checkout")
    if result.special:
        raise ValueError("Refusing to modify a checkout containing unresolved special files")
    collator = Path(__file__).with_name("codex-collate-session-artifacts")
    loader = importlib.machinery.SourceFileLoader("codex_collate_session_artifacts", str(collator))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("Could not load the session-artifact collator")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    candidates = [
        module.Source("orphan-monorepo", (root / path).relative_to(home))
        for path in (*result.modified, *result.untracked)
    ]
    module.collate(
        home, home / "Google Drive" / "My Drive" / "Codex" / "recovered", candidates
    )
    return len(candidates)


def remove_snapshot(
    root: Path, repository: Path, *, expected_roots: int, home: Path
) -> dict[str, object]:
    candidates = snapshot_roots(root, repository)
    if len(candidates) != expected_roots:
        raise ValueError(
            f"Refusing to remove {len(candidates)} snapshot roots; expected {expected_roots}"
        )
    notes_root = root / ".codex"
    if notes_root in candidates:
        collator = Path(__file__).with_name("codex-collate-session-artifacts")
        loader = importlib.machinery.SourceFileLoader(
            "codex_collate_session_artifacts", str(collator)
        )
        spec = importlib.util.spec_from_loader(loader.name, loader)
        if spec is None:
            raise RuntimeError("Could not load the session-artifact collator")
        module = importlib.util.module_from_spec(spec)
        sys.modules[loader.name] = module
        loader.exec_module(module)
        sources = []
        for directory in (notes_root, notes_root / "handoffs", notes_root / "initiatives"):
            if not directory.is_dir():
                continue
            with os.scandir(directory) as entries:
                for entry in entries:
                    if entry.name.endswith(".md") and entry.is_file(follow_symlinks=False):
                        sources.append(
                            module.Source(
                                "orphan-monorepo-note",
                                Path(entry.path).relative_to(home),
                            )
                        )
        module.collate(
            home, home / "Google Drive" / "My Drive" / "Codex" / "recovered", sources
        )
    for path in candidates:
        if path.is_symlink():
            raise RuntimeError(f"Snapshot root became a symlink: {path}")
        if path.is_dir():
            shutil.rmtree(path)
        elif path.is_file():
            path.unlink()
        else:
            raise RuntimeError(f"Snapshot root changed during removal: {path}")
    return {"removed_roots": len(candidates), "names": [path.name for path in candidates]}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.home() / "code")
    parser.add_argument("--repository", type=Path, required=True)
    parser.add_argument("--max-files", type=int, default=2500)
    parser.add_argument("--max-hash-mib", type=int, default=64)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--check", action="store_true")
    action.add_argument("--archive", action="store_true")
    action.add_argument("--remove", action="store_true")
    parser.add_argument("--expected-roots", type=int, default=88)
    arguments = parser.parse_args(argv)
    if arguments.max_files <= 0 or arguments.max_hash_mib <= 0:
        parser.error("Audit budgets must be positive")
    if arguments.check:
        candidates = snapshot_roots(arguments.root, arguments.repository)
        if len(candidates) != arguments.expected_roots:
            parser.error(
                f"Expected {arguments.expected_roots} snapshot roots; found {len(candidates)}"
            )
        print(
            json.dumps(
                {
                    "root": str(arguments.root),
                    "repository": str(arguments.repository),
                    "count": len(candidates),
                    "names": [path.name for path in candidates],
                },
                sort_keys=True,
            )
        )
        return 0
    if arguments.remove:
        result = remove_snapshot(
            arguments.root,
            arguments.repository,
            expected_roots=arguments.expected_roots,
            home=Path.home(),
        )
        print(json.dumps(result, sort_keys=True))
        return 0
    result = audit(
        arguments.root,
        arguments.repository,
        max_files=arguments.max_files,
        max_hash_bytes=arguments.max_hash_mib * 1024 * 1024,
    )
    payload: dict[str, object] = {
        "root": str(arguments.root),
        "repository": str(arguments.repository),
        "candidate_roots": result.candidates,
        "complete": result.complete,
        "scanned_files": result.scanned_files,
        "hashed_bytes": result.hashed_bytes,
        "matched": result.matched,
        "modified": result.modified,
        "untracked": result.untracked,
        "protected_git_roots": result.protected,
        "special": result.special,
    }
    if arguments.archive:
        payload["archived"] = archive(result, arguments.root, Path.home())
    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
