#!/usr/bin/env python3
"""Move complete Codex session stores into shared storage without copying them."""

from __future__ import annotations

import argparse
from collections.abc import Sequence
import filecmp
import json
import os
from pathlib import Path
import runpy
import shutil
import socket
import sys
import time
from typing import Callable, cast


SESSION_STATE = (
    "rotated_rollout_segments",
    "archived_sessions",
    "attachments",
    "session_index.jsonl",
)
_exchange = cast(
    Callable[[Path, Path], None],
    runpy.run_path(str(Path(__file__).with_name("codex-migrate-memories")))["exchange"],
)


def _verify_file(source: Path, target: Path) -> int:
    if target.is_symlink() or not target.is_file() or not source.is_file():
        raise ValueError("shared session file is absent from the local store")
    size = target.stat().st_size
    if size != source.stat().st_size:
        raise ValueError("shared session file differs from the local store")
    if not filecmp.cmp(source, target, shallow=False):
        raise ValueError("shared session file differs from the local store")
    return size


def _session_index_suffix(source: Path, target: Path) -> bytes:
    if target.is_symlink() or not target.is_file() or not source.is_file():
        raise ValueError("shared session index is absent from the local store")
    local = source.read_bytes()
    shared = target.read_bytes()
    if not local.startswith(shared) or (shared and not shared.endswith(b"\n")):
        raise ValueError("shared session index conflicts with local history")
    return local[len(shared) :]


def _verify_subset(source: Path, target: Path) -> tuple[int, int]:
    if not target.exists():
        return 0, 0
    if source.is_file():
        if source.name == "session_index.jsonl":
            _ = _session_index_suffix(source, target)
            return 1, target.stat().st_size
        return 1, _verify_file(source, target)
    if target.is_symlink() or not target.is_dir():
        raise ValueError("shared session store is not a real directory: " + str(target))
    count = 0
    size = 0
    for parent, directories, filenames in os.walk(target):
        for name in directories:
            if Path(parent, name).is_symlink():
                raise ValueError("shared session store contains a symbolic link")
        for name in filenames:
            existing = Path(parent, name)
            original = source / existing.relative_to(target)
            size += _verify_file(original, existing)
            count += 1
    return count, size


def _sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _require_leader(shared_root: Path) -> None:
    with (shared_root / "runtime" / "backup-leader.json").open(
        encoding="utf-8"
    ) as source:
        record = cast(object, json.load(source))
    if not isinstance(record, dict):
        raise ValueError("backup leader record is invalid")
    leader = cast(dict[str, object], record).get("hostname")
    if leader != socket.gethostname():
        raise PermissionError(
            "only the elected backup leader may migrate session state"
        )


def _discard_reconciled(path: Path, target: Path) -> None:
    if path.is_file():
        _ = _verify_file(path, target)
        path.unlink()
        return
    children = tuple(path.iterdir())
    for child in children:
        destination = target / child.name
        if not child.is_symlink() or not destination.exists():
            raise RuntimeError("local session store changed during migration")
        if child.resolve() != destination.resolve():
            raise RuntimeError("local session store changed during migration")
    removed: list[tuple[Path, Path]] = []
    try:
        for child in children:
            destination = target / child.name
            child.unlink()
            removed.append((child, destination))
        path.rmdir()
    except BaseException:
        for child, destination in removed:
            os.symlink(destination, child, target_is_directory=destination.is_dir())
        raise


def _link_reconciled(source: Path, target: Path) -> None:
    temporary = source.parent / ("." + source.name + ".migration-link")
    if temporary.exists() or temporary.is_symlink():
        raise ValueError("previous migration link already exists: " + str(temporary))
    exchanged = False
    try:
        os.symlink(target, temporary, target_is_directory=target.is_dir())
        _sync_directory(source.parent)
        _exchange(source, temporary)
        exchanged = True
        _sync_directory(source.parent)
        if not source.is_symlink() or source.resolve() != target.resolve():
            raise RuntimeError("atomic migration did not retain the local session path")
        _discard_reconciled(temporary, target)
    except BaseException:
        if exchanged:
            _exchange(source, temporary)
        if temporary.is_symlink():
            temporary.unlink()
        _sync_directory(source.parent)
        raise
    _sync_directory(source.parent)


def _publish_missing(source: Path, target: Path) -> None:
    if target.exists() or target.is_symlink():
        raise FileExistsError("shared session item already exists: " + str(target))
    inode = source.stat().st_ino
    exchanged = False
    try:
        os.symlink(target, target, target_is_directory=source.is_dir())
        _sync_directory(target.parent)
        _exchange(source, target)
        exchanged = True
        _sync_directory(source.parent)
        _sync_directory(target.parent)
        if not source.is_symlink() or source.resolve() != target.resolve():
            raise RuntimeError("atomic item migration did not retain its local path")
        if target.stat().st_ino != inode:
            raise RuntimeError("atomic item migration did not retain its source inode")
    except BaseException:
        if exchanged:
            _exchange(source, target)
        if target.is_symlink():
            target.unlink()
        _sync_directory(source.parent)
        _sync_directory(target.parent)
        raise


def _merge_directory(source: Path, target: Path) -> None:
    for original in tuple(source.iterdir()):
        shared = target / original.name
        if original.is_symlink():
            if not shared.exists() or original.resolve() != shared.resolve():
                raise ValueError("local session item points to another destination")
            continue
        if not shared.exists():
            _publish_missing(original, shared)
        elif original.is_dir() and shared.is_dir() and not shared.is_symlink():
            _merge_directory(original, shared)
            _link_reconciled(original, shared)
        elif original.is_file():
            _ = _verify_file(original, shared)
            _link_reconciled(original, shared)
        else:
            raise ValueError("shared session item conflicts with the local store")


def migrate_path(source: Path, target: Path, *, dry_run: bool) -> dict[str, object]:
    if source.is_symlink():
        if not target.exists() or source.resolve() != target.resolve():
            raise ValueError("local session store points to another destination")
        return {"directory": source.name, "status": "linked"}
    if not source.is_dir() and not source.is_file():
        raise ValueError("local session store does not exist: " + str(source))
    if source.stat().st_dev != target.parent.stat().st_dev:
        raise ValueError("session stores are on different filesystems")
    count, size = _verify_subset(source, target)
    if dry_run:
        return {
            "directory": source.name,
            "status": "ready",
            "duplicate_files": count,
            "duplicate_bytes": size,
        }

    if source.is_dir():
        # Drive associates cloud folders with their inode; replacing this root trashes it.
        if not target.exists():
            target.mkdir(mode=0o700)
            _sync_directory(target.parent)
        if not target.is_dir() or target.is_symlink():
            raise ValueError("shared session store is not a real directory")
        target_inode = target.stat().st_ino
        _merge_directory(source, target)
    else:
        if not target.exists():
            with source.open("rb") as original, target.open("xb") as shared:
                shutil.copyfileobj(original, shared)
                shared.flush()
                os.fsync(shared.fileno())
            _sync_directory(target.parent)
        elif source.name == "session_index.jsonl":
            suffix = _session_index_suffix(source, target)
            if suffix:
                with target.open("ab") as shared:
                    _ = shared.write(suffix)
                    shared.flush()
                    os.fsync(shared.fileno())
                _sync_directory(target.parent)
        target_inode = target.stat().st_ino
        _ = _verify_file(source, target)
    _link_reconciled(source, target)
    if target.stat().st_ino != target_inode:
        raise RuntimeError("provider-owned shared session identity changed")
    return {
        "directory": source.name,
        "status": "migrated",
        "removed_duplicate_files": count,
        "removed_duplicate_bytes": size,
    }


def migrate(codex_home: Path, shared_root: Path, *, dry_run: bool) -> dict[str, object]:
    if not dry_run:
        _require_leader(shared_root)
    return {
        "status": "dry_run" if dry_run else "completed",
        "directories": [
            migrate_path(codex_home / name, shared_root / name, dry_run=dry_run)
            for name in SESSION_STATE
        ],
    }


def link_path(source: Path, target: Path) -> dict[str, object]:
    if not target.exists() or target.is_symlink():
        raise ValueError("shared session state is unavailable: " + str(target))
    if source.is_symlink():
        if source.resolve() != target.resolve():
            raise ValueError("local session store points to another destination")
        return {"directory": source.name, "status": "linked"}
    if source.is_dir():
        try:
            source.rmdir()
        except OSError as error:
            raise ValueError(
                "refusing to replace nonempty local session state"
            ) from error
    elif source.is_file():
        if source.stat().st_size:
            raise ValueError("refusing to replace nonempty local session state")
        source.unlink()
    elif source.exists():
        raise ValueError("local session state is not a regular file or directory")
    os.symlink(target, source, target_is_directory=target.is_dir())
    _sync_directory(source.parent)
    return {"directory": source.name, "status": "linked"}


def _wait_for_shared_state(shared_root: Path, seconds: float) -> None:
    deadline = time.monotonic() + seconds
    announced = False
    while True:
        missing = [name for name in SESSION_STATE if not (shared_root / name).exists()]
        if not missing:
            return
        if time.monotonic() >= deadline:
            raise FileNotFoundError(
                "Google Drive has not synchronized the leader's session state: "
                + ", ".join(missing)
                + ". Wait for Google Drive to finish syncing, then retry."
            )
        if not announced:
            print(
                "Waiting for Google Drive to synchronize session state: "
                + ", ".join(missing),
                file=sys.stderr,
                flush=True,
            )
            announced = True
        time.sleep(min(1.0, max(0.0, deadline - time.monotonic())))


def link(
    codex_home: Path, shared_root: Path, *, wait_seconds: float = 30
) -> dict[str, object]:
    _wait_for_shared_state(shared_root, wait_seconds)
    return {
        "status": "linked",
        "directories": [
            link_path(codex_home / name, shared_root / name) for name in SESSION_STATE
        ],
    }


def main(argv: Sequence[str] = ()) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    _ = modes.add_argument("--dry-run", action="store_true")
    _ = modes.add_argument("--link", action="store_true")
    _ = parser.add_argument("--wait", type=float, default=30)
    arguments = parser.parse_args(argv or None)
    codex_home = Path.home() / ".codex"
    shared_root = (codex_home / "sessions").resolve().parent
    try:
        result = (
            link(codex_home, shared_root, wait_seconds=cast(float, arguments.wait))
            if cast(bool, arguments.link)
            else migrate(codex_home, shared_root, dry_run=cast(bool, arguments.dry_run))
        )
    except (OSError, RuntimeError, ValueError) as error:
        print("Codex session setup failed: " + str(error), file=sys.stderr)
        return 1
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
