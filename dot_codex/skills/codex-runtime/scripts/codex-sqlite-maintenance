#!/usr/bin/env python3
"""Return already-free Codex log pages to the filesystem without stopping Codex."""

from __future__ import annotations

import argparse
import sqlite3
import sys
import time
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from shutil import disk_usage
from typing import Literal, TextIO
from urllib.parse import quote


GIB = 1024**3
TARGET_FREE_BYTES = 50 * GIB
CHUNK_PAGES = 1024
BUSY_TIMEOUT_SECONDS = 0.25
MAX_BUSY_RETRIES = 12
BUSY_RETRY_DELAY_SECONDS = 0.05
MAX_SECONDS = 30 * 60
PROGRESS_INTERVAL = 16
STALL_BATCHES = 32


@dataclass(frozen=True)
class Result:
    status: Literal["target", "exhausted", "timeout", "stalled", "busy", "error"]
    reclaimed_bytes: int
    remaining_pages: int
    batches: int


@dataclass(frozen=True)
class Checkpoint:
    busy: int
    frames: int
    checkpointed: int


def available_bytes(path: Path) -> int:
    return disk_usage(path.parent).free


def allocated_bytes(path: Path) -> int:
    allocated = path.stat().st_blocks * 512
    wal = path.with_name(path.name + "-wal")
    try:
        return allocated + wal.stat().st_blocks * 512
    except FileNotFoundError:
        return allocated


def pragma(connection: sqlite3.Connection, name: str) -> int:
    row: object = connection.execute("PRAGMA " + name).fetchone()
    if not isinstance(row, tuple) or len(row) != 1:
        raise RuntimeError("SQLite returned no integer for " + name)
    value: object = row[0]
    if not isinstance(value, int):
        raise RuntimeError("SQLite returned no integer for " + name)
    return value


def passive_checkpoint(connection: sqlite3.Connection) -> Checkpoint:
    row: object = connection.execute("PRAGMA wal_checkpoint(PASSIVE)").fetchone()
    if not isinstance(row, tuple) or len(row) != 3:
        raise RuntimeError("SQLite returned invalid passive checkpoint statistics")
    busy: object = row[0]
    frames: object = row[1]
    checkpointed: object = row[2]
    if not isinstance(busy, int) or not isinstance(frames, int):
        raise RuntimeError("SQLite returned invalid passive checkpoint statistics")
    if not isinstance(checkpointed, int):
        raise RuntimeError("SQLite returned invalid passive checkpoint statistics")
    return Checkpoint(busy, frames, checkpointed)


def compact(
    path: Path,
    *,
    target_free_bytes: int = TARGET_FREE_BYTES,
    free_space: Callable[[Path], int] = available_bytes,
    allocated_space: Callable[[Path], int] = allocated_bytes,
    clock: Callable[[], float] = time.monotonic,
    output: TextIO = sys.stdout,
) -> Result:
    uri = "file:" + quote(str(path), safe="/") + "?mode=rw"
    reclaimed_pages = 0
    remaining_pages = 0
    page_size = 0
    batches = 0
    deadline = clock() + MAX_SECONDS

    try:
        with sqlite3.connect(
            uri,
            uri=True,
            timeout=BUSY_TIMEOUT_SECONDS,
            isolation_level=None,
        ) as connection:
            journal: object = connection.execute("PRAGMA journal_mode").fetchone()
            if journal != ("wal",):
                raise RuntimeError("Codex logs must already use WAL")
            if pragma(connection, "auto_vacuum") != 2:
                raise RuntimeError(
                    "Codex logs must already use incremental auto-vacuum"
                )

            page_size = pragma(connection, "page_size")
            if page_size <= 0:
                raise RuntimeError("SQLite returned an invalid page size")
            remaining_pages = pragma(connection, "freelist_count")
            best_free_bytes = free_space(path)
            window_free_bytes = best_free_bytes
            window_allocated_bytes = allocated_space(path)
            window_page_count = pragma(connection, "page_count")

            print(
                "Codex log maintenance: "
                + str(remaining_pages)
                + " free pages; "
                + f"{best_free_bytes / GIB:.2f}"
                + " GiB available",
                file=output,
                flush=True,
            )

            busy_retries = 0
            while remaining_pages and best_free_bytes < target_free_bytes:
                if clock() >= deadline:
                    return Result(
                        "timeout", reclaimed_pages * page_size, remaining_pages, batches
                    )

                previous_pages = remaining_pages
                try:
                    _ = connection.execute(
                        "PRAGMA incremental_vacuum(" + str(CHUNK_PAGES) + ")"
                    ).fetchall()
                except sqlite3.OperationalError as error:
                    message = str(error).lower()
                    if "locked" not in message and "busy" not in message:
                        raise
                    busy_retries += 1
                    if busy_retries > MAX_BUSY_RETRIES:
                        raise
                    remaining_time = deadline - clock()
                    if remaining_time <= 0:
                        return Result(
                            "timeout",
                            reclaimed_pages * page_size,
                            remaining_pages,
                            batches,
                        )
                    time.sleep(
                        min(
                            BUSY_RETRY_DELAY_SECONDS * 2 ** min(busy_retries - 1, 4),
                            remaining_time,
                        )
                    )
                    continue
                busy_retries = 0
                remaining_pages = pragma(connection, "freelist_count")
                batches += 1
                removed_pages = max(previous_pages - remaining_pages, 0)
                reclaimed_pages += removed_pages

                current_free_bytes = free_space(path)
                if current_free_bytes > best_free_bytes:
                    best_free_bytes = current_free_bytes

                if batches % STALL_BATCHES == 0 and remaining_pages:
                    checkpoint = passive_checkpoint(connection)
                    current_page_count = pragma(connection, "page_count")
                    current_allocated_bytes = allocated_space(path)
                    current_free_bytes = free_space(path)
                    if current_free_bytes > best_free_bytes:
                        best_free_bytes = current_free_bytes
                    if current_page_count >= window_page_count or (
                        current_allocated_bytes >= window_allocated_bytes
                        and current_free_bytes <= window_free_bytes
                    ):
                        print(
                            "Codex log maintenance stalled: checkpointed "
                            + str(checkpoint.checkpointed)
                            + " of "
                            + str(checkpoint.frames)
                            + " WAL frames; "
                            + f"{current_free_bytes / GIB:.2f}"
                            + " GiB available",
                            file=output,
                            flush=True,
                        )
                        return Result(
                            "stalled",
                            reclaimed_pages * page_size,
                            remaining_pages,
                            batches,
                        )
                    window_page_count = current_page_count
                    window_allocated_bytes = current_allocated_bytes
                    window_free_bytes = current_free_bytes

                if batches % PROGRESS_INTERVAL == 0:
                    print(
                        "Codex log maintenance: "
                        + f"{reclaimed_pages * page_size / (1024 * 1024):.1f}"
                        + " MiB reclaimed; "
                        + f"{current_free_bytes / GIB:.2f}"
                        + " GiB available",
                        file=output,
                        flush=True,
                    )

            status: Literal["target", "exhausted"] = (
                "target" if best_free_bytes >= target_free_bytes else "exhausted"
            )
            return Result(status, reclaimed_pages * page_size, remaining_pages, batches)
    except sqlite3.OperationalError as error:
        message = str(error)
        error_status: Literal["busy", "error"] = (
            "busy"
            if "locked" in message.lower() or "busy" in message.lower()
            else "error"
        )
        print("Codex log maintenance stopped: " + message, file=sys.stderr, flush=True)
        return Result(
            error_status, reclaimed_pages * page_size, remaining_pages, batches
        )
    except (OSError, RuntimeError, sqlite3.Error) as error:
        print(
            "Codex log maintenance stopped: " + str(error), file=sys.stderr, flush=True
        )
        return Result("error", reclaimed_pages * page_size, remaining_pages, batches)


def main(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    _ = parser.add_argument(
        "--target-free-gib",
        type=int,
        default=TARGET_FREE_BYTES // GIB,
        help="stop after this many GiB of filesystem space are available",
    )
    try:
        options = parser.parse_args(arguments)
        target_free_gib: object = vars(options).get("target_free_gib")
        if not isinstance(target_free_gib, int) or target_free_gib <= 0:
            parser.error("--target-free-gib must be positive")
    except SystemExit as error:
        return 0 if error.code == 0 else 2

    try:
        result = compact(
            Path.home() / ".codex" / "logs_2.sqlite",
            target_free_bytes=target_free_gib * GIB,
        )
    except KeyboardInterrupt:
        print("Codex log maintenance interrupted safely", file=sys.stderr, flush=True)
        return 130

    print(
        "Codex log maintenance "
        + result.status
        + ": "
        + f"{result.reclaimed_bytes / (1024 * 1024):.1f}"
        + " MiB reclaimed in "
        + str(result.batches)
        + " batches; "
        + str(result.remaining_pages)
        + " free pages remain",
        flush=True,
    )
    return 0 if result.status in {"target", "exhausted"} else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
