[advice]
	mergeConflict = false
	skippedCherryPicks = false
[am]
	threeWay = true
[color]
	ui = auto
[commit]
	gpgSign = true
[commitGraph]
	changedPaths = true
	changedPathsVersion = 2
[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global
	commentchar = ";"
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[fetch]
	parallel = 0
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[gpg]
	format = ssh
[http]
	cookiefile = ~/.gitcookies
[hub]
	protocol = ssh
[index]
	threads = true
[init]
	defaultBranch = main
[log]
	follow = true
	mailmap = true
[maintenance]
	repo = ~/code/openai/openai
[merge]
	conflictstyle = diff3
	renamelimit = 15000
[pull]
	rebase = true
[patatt]
	signingkey = openssh:~/.ssh/patatt.pub
[push]
	autoSetupRemote = true
	default = simple
[rebase]
	autoSquash = true
	autoStash = true
	rebaseMerges = true
	updateRefs = true
[repo]
	superprojectChoice = true
	superprojectChoiceExpire = 1635800846
[rerere]
	autoupdate = true
	enabled = true
[sendemail]
	smtpEncryption = tls
	smtpServer     = smtp.gmail.com
	smtpServerPort = 587
	smtpUser       = tamird@gmail.com
