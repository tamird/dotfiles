startup --experimental_remote_repo_contents_cache
build --experimental_output_paths=strip

# Keep shared local Bazel caches bounded by age across workspaces.
common:mac_laptop --experimental_disk_cache_gc_max_size=50G
common:mac_laptop --experimental_disk_cache_gc_max_age=1d
common:mac_laptop --repo_contents_cache_gc_max_age=1d
common:mac_laptop --remote_download_outputs=minimal
