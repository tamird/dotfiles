#!/usr/bin/env python3
"""Connect portable Codex state and control its optional backup service."""

import subprocess
import sys
from pathlib import Path

home = Path.home()
codex = home / ".codex"
root = home / "Google Drive" / "My Drive" / "Codex"
scripts = codex / "skills" / "codex-runtime" / "scripts"


def run(script: str, *arguments: str) -> None:
    result = subprocess.run(["/usr/bin/python3", str(scripts / script), *arguments])
    if result.returncode:
        raise SystemExit(result.returncode)


def link(source: Path, destination: Path) -> None:
    if source.is_symlink():
        if source.resolve() != destination.resolve():
            raise FileExistsError(source)
    elif source.exists():
        raise FileExistsError(source)
    else:
        source.symlink_to(destination, target_is_directory=destination.is_dir())


if len(sys.argv) != 2 or sys.argv[1] not in {"leader", "follower", "stop"}:
    raise SystemExit("usage: codex-bootstrap leader|follower|stop")

role = sys.argv[1]
if role == "stop":
    run("codex-state-backup", "stop")
    raise SystemExit

if not root.is_dir():
    raise NotADirectoryError(root)
codex.mkdir(exist_ok=True)
(root / "rollouts").mkdir(exist_ok=True)
link(codex / "sessions", root / "rollouts")

if role == "leader":
    run("codex-state-backup", "elect", "--leader")
    run("codex-state-backup", "stop")
    if (root / "memories").is_dir():
        run("codex-migrate-memories")
    run("codex-migrate-session-state")
    run("codex-state-backup", "install", "--leader")
    run("codex-state-backup", "restore", "--missing")
else:
    run("codex-state-backup", "stop")
    if (root / "memories").is_dir():
        link(codex / "memories", root / "memories")
    run("codex-migrate-session-state", "--link")
    run("codex-state-backup", "restore", "--missing", "--repair-empty")
