#!/usr/bin/env python3
"""Format changed Python lines using ruff format --range."""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from difflib import SequenceMatcher

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
SUPPORTED_EXTS = (".py", ".pyi", ".pyw")


def run_git_diff(git_args):
    cmd = ["git", "diff", "-U0"]
    if git_args:
        cmd.extend(git_args)

    proc = subprocess.run(cmd, check=False, text=True, capture_output=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.exit(proc.returncode)
    return proc.stdout


def parse_ranges(diff_text):
    ranges = {}
    current = None

    for line in diff_text.splitlines():
        if line.startswith("+++ "):
            path = line[4:].strip()
            if path == "/dev/null":
                current = None
                continue
            if path.startswith("b/"):
                path = path[2:]
            current = path
            ranges.setdefault(current, [])
            continue

        if line.startswith("@@ "):
            if current is None:
                continue
            match = HUNK_RE.match(line)
            if not match:
                continue
            new_start = int(match.group(3))
            new_len = int(match.group(4) or "1")
            if new_len == 0:
                continue
            ranges[current].append((new_start, new_start + new_len - 1))

    return ranges


def merge_ranges(ranges):
    if not ranges:
        return []
    ranges.sort()
    merged = [[ranges[0][0], ranges[0][1]]]
    for start, end in ranges[1:]:
        if start > merged[-1][1] + 1:
            merged.append([start, end])
        else:
            merged[-1][1] = max(merged[-1][1], end)
    return [(start, end) for start, end in merged]


def apply_format_range(ruff, path, lines, start, end):
    line_count = len(lines)
    end_exclusive = min(end + 1, line_count + 1)
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        delete=False,
        prefix="ruff-format-",
        suffix=".py",
    ) as temp:
        temp.writelines(lines)
        temp_path = temp.name

    try:
        cmd = [ruff, "format", "--range", f"{start}-{end_exclusive}", temp_path]
        subprocess.run(cmd, check=True)
        with open(temp_path, "r", encoding="utf-8") as handle:
            formatted_lines = handle.readlines()
    finally:
        os.unlink(temp_path)

    matcher = SequenceMatcher(None, lines, formatted_lines)
    output = []
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == "equal":
            output.extend(lines[i1:i2])
            continue

        if i1 == i2:
            pos = i1 + 1
            intersects = start <= pos <= end
        else:
            intersects = not (i2 < start or i1 + 1 > end)

        if intersects:
            output.extend(formatted_lines[j1:j2])
        else:
            output.extend(lines[i1:i2])

    return output


def format_file(ruff, path, ranges):
    with open(path, "r", encoding="utf-8") as handle:
        lines = handle.readlines()

    for start, end in sorted(ranges, reverse=True):
        lines = apply_format_range(ruff, path, lines, start, end)

    with open(path, "w", encoding="utf-8") as handle:
        handle.writelines(lines)


def main():
    parser = argparse.ArgumentParser(
        description="Format changed Python lines with ruff format --range.",
    )
    parser.add_argument(
        "--ruff",
        default=os.environ.get("RUFF", "ruff"),
        help="path to ruff executable (default: ruff or $RUFF)",
    )
    parser.add_argument(
        "git_args",
        nargs=argparse.REMAINDER,
        help="arguments passed through to git diff (use -- to separate)",
    )
    args = parser.parse_args()

    git_args = args.git_args
    if git_args and git_args[0] == "--":
        git_args = git_args[1:]
    diff_text = run_git_diff(git_args)
    file_ranges = parse_ranges(diff_text)

    formatted = 0
    for path, ranges in file_ranges.items():
        if not path.endswith(SUPPORTED_EXTS):
            continue
        if not os.path.exists(path):
            continue
        merged = merge_ranges(ranges)
        if not merged:
            continue
        format_file(args.ruff, path, merged)
        formatted += 1

    if formatted == 0:
        print("No Python changes to format.")


if __name__ == "__main__":
    main()
