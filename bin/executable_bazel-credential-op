#!/usr/bin/env python3
"""Read a BuildBuddy API key from a 1Password secret reference for Bazel."""

import json
import subprocess
import sys
from typing import TextIO
from urllib.parse import urlparse

REFERENCE = "op://Private/fyyg7wesemhezilz264aljzbfy/credential"
HOST = "openai.buildbuddy.io"


def read_credential(stream: TextIO) -> dict[str, object]:
    """Parse Bazel's JSON credential request."""
    try:
        credential = json.load(stream)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise SystemExit("bazel-credential-op: malformed credential input") from error
    if not isinstance(credential, dict):
        raise SystemExit("bazel-credential-op: malformed credential input")
    return credential


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: bazel-credential-op <operation>")

    operation = sys.argv[1]
    credential = read_credential(sys.stdin)

    match operation, credential:
        case "get", {"uri": str(uri)} if urlparse(uri).hostname == HOST:
            password = subprocess.run(
                ["op", "read", REFERENCE],
                check=True,
                stdout=subprocess.PIPE,
                text=True,
            ).stdout.removesuffix("\n")
            if "\n" in password or "\0" in password:
                raise SystemExit("bazel-credential-op: credential is not line-safe")
            print(json.dumps({"headers": {"x-buildbuddy-api-key": [password]}}))
        case "get", _:
            raise SystemExit("bazel-credential-op: unsupported credential request")
        case _:
            raise SystemExit("bazel-credential-op: unsupported operation")


if __name__ == "__main__":
    main()
