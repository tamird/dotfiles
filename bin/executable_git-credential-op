#!/usr/bin/env python3
"""Read an SMTP password from a 1Password secret reference for Git."""

import subprocess
import sys
from typing import TextIO


def read_credential(stream: TextIO) -> dict[str, str]:
    """Parse Git's newline-delimited credential attributes."""
    credential: dict[str, str] = {}
    for raw_line in stream:
        line = raw_line.removesuffix("\n")
        if not line:
            break
        key, separator, value = line.partition("=")
        if not separator:
            raise SystemExit("git-credential-op: malformed credential input")
        credential[key] = value
    return credential


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: git-credential-op <1password-reference> <operation>")

    reference, operation = sys.argv[1:]
    credential = read_credential(sys.stdin)

    match operation, credential:
        case "get", {"protocol": "smtp", "host": _, "username": _}:
            password = subprocess.run(
                ["op", "read", reference],
                check=True,
                stdout=subprocess.PIPE,
                text=True,
            ).stdout.removesuffix("\n")
            if "\n" in password or "\0" in password:
                raise SystemExit("git-credential-op: password is not line-safe")
            print(f"password={password}")
        case "store" | "erase", _:
            # 1Password remains the source of truth.
            pass
        case _:
            # gitcredentials(7) permits "no values at all" for get and says a
            # helper receiving another operation "should silently ignore the request."
            pass


if __name__ == "__main__":
    main()
